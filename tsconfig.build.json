{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/components/**/*",
    "src/index.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "**/*.stories.*",
    "**/*.test.*",
    "**/node_modules/**",
    "**/dist/**",
    "**/_TEMPLATE/**",
    "src/components/_TEMPLATE/**"
  ]
}
