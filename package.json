{
  "name": "@nbs/component-library",
  "private": false,
  "version": "1.1.2",
  "description": "Production-ready React component library with TypeScript and Storybook",
  "keywords": [
    "react",
    "components",
    "typescript",
    "storybook",
    "ui-library",
    "component-library"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./dist/styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "dist/styles.css"
  ],
  "files": [
    "dist",
    "HowToConsume.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/syednaqvi98nibras/StoryBook.git"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && rollup -c && node -e \"require('fs').copyFileSync('StoryBook/ConsumerComponents/styles/tokens.css', 'dist/tokens.css')\" && tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:analyze": "npm run build && node scripts/analyze-bundle.js",
    "analyze": "node scripts/analyze-bundle.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "performance": "npm run build:analyze",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006 -c StoryBook/UiPreview/.storybook",
    "build-storybook": "storybook build -c StoryBook/UiPreview/.storybook",
    "dev:all": "concurrently \"npm run dev\" \"npm run storybook\" --names \"VITE,STORYBOOK\" --prefix-colors \"blue,green\"",
    "build:library": "npm run build",
    "prepare": "node -e \"require('fs').existsSync('dist/index.js') || require('child_process').execSync('npm run build', {stdio: 'inherit'})\"",
    "prepublishOnly": "npm run build",
    "create-component": "node scripts/create-component.js",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && node scripts/update-latest-branch.js",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && node scripts/update-latest-branch.js",
    "release:major": "npm version major -m \"chore(release): v%s\" && node scripts/update-latest-branch.js",
    "release:push": "git push origin master --follow-tags",
    "release:update-latest": "node scripts/update-latest-branch.js"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@fontsource/inter": "^5.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@radix-ui/react-slot": "^1.2.4",
    "antd": "^5.26.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react-apexcharts": "^1.8.0",
    "react-error-boundary": "^6.0.0",
    "react-feather": "^2.0.10",
    "react-perfect-scrollbar": "^1.5.8",
    "react-quill-new": "^3.6.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@reduxjs/toolkit": "^2.11.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/builder-vite": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dragula": "^3.7.5",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-input-mask": "^3.0.6",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "apexcharts": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "bootstrap": "^5.3.8",
    "clipboard-copy": "^4.0.1",
    "concurrently": "^9.2.1",
    "dragula": "^3.7.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jquery": "^3.7.1",
    "jsdom": "^25.0.1",
    "leaflet": "^1.9.4",
    "moment": "^2.30.1",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "quill": "^2.0.3",
    "react": "^19.2.0",
    "react-awesome-stars-rating": "^0.16.2",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-daterangepicker": "^8.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-country-flag": "^3.1.0",
    "react-countup": "^6.5.3",
    "react-datepicker": "^7.6.0",
    "react-dom": "^19.2.0",
    "react-feather": "^2.0.10",
    "react-icons": "^5.5.0",
    "react-input-mask": "^2.0.4",
    "react-redux": "^9.2.0",
    "react-router": "^7.9.6",
    "react-router-dom": "^7.9.6",
    "react-select": "^5.10.2",
    "react-simple-wysiwyg": "^3.4.1",
    "react-slick": "^0.31.0",
    "react-tag-input": "^6.10.6",
    "react-time-picker": "^7.0.0",
    "resolve-url-loader": "^5.0.0",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.94.2",
    "slick-carousel": "^1.8.1",
    "storybook": "^8.6.14",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.1.18",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^2.1.8",
    "weather-icons-react": "^1.2.0",
    "web-vitals": "^4.2.4",
    "yet-another-react-lightbox": "^3.25.0"
  }
}
